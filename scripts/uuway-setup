#!/usr/bin/env bash
# Interactive first-run setup; no account data or screen grant is preinstalled.
set -Eeuo pipefail
[[ $EUID -ne 0 ]] || { echo '请以桌面用户运行 UUWay 安装向导。'; exit 1; }
installer=()
prefix="${XDG_DATA_HOME:-$HOME/.local/share}/wineprefixes/uu-remote"
if [[ ! -f "$prefix/drive_c/Program Files/Netease/GameViewer/bin/GameViewerServer.exe" ]]; then
    echo '请选择从 https://uuyc.163.com/ 下载的 UU 远程 Windows 官方安装包。'
    chosen="$(zenity --file-selection --title='选择 UU 远程官方 Windows 安装包' \
        --filename="$HOME/Downloads/" --file-filter='Windows 安装包 | *.exe')" || exit 0
    [[ -f "$chosen" ]] || exit 1
    installer=(--installer "$chosen")
fi
/usr/bin/uuway setup --yes --only wine,udev,prefix,helpers,fcitx,portal,runtime,start,consent,launchers "${installer[@]}"
echo '默认配置：greetd 自动登录后立即密码锁屏，UU 在锁屏后台运行；GNOME Keyring 由锁屏 PAM 解锁。'
echo '配置从下次登录生效。不会保存密码，也不会重启当前桌面。'
exec /usr/bin/python3 /usr/lib/uuway/scripts/uuway_desktop.py install "$@"
